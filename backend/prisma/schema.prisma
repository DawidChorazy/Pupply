generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  USER
  CLINIC
  ADMIN
}

enum ClinicVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum SitterVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum SitterVerificationFilePurpose {
  IDENTITY_DOCUMENT
  FACE_PHOTO
}

enum PetGender {
  MALE
  FEMALE
}

enum SitterServiceType {
  DOG_WALK
  DROP_IN
  DAY_CARE
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum NotificationType {
  ISSUE_UPDATED
  PAYMENT_COMPLETED
  PAYMENT_REFUNDED
  WALK_STARTED
  NEW_MESSAGE
  BOOKING_REQUESTED
  BOOKING_ACCEPTED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  BOOKING_EXPIRED
  DOCUMENT_EXPIRING
}

enum AccountTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  EMAIL_CHANGE
}

model Account {
  id              String               @id @default(cuid())
  email           String               @unique
  passwordHash    String?
  googleId        String?              @unique
  role            AccountRole
  emailVerifiedAt DateTime?
  authVersion     Int                  @default(0)
  deactivatedAt   DateTime?
  blockedAt       DateTime?
  emailNotifications Boolean           @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  userProfile     UserProfile?
  clinicProfile   ClinicProfile?
  refreshTokens   RefreshToken[]
  actionTokens    AccountActionToken[]
  pets            Pet[]
  sitterProfile   SitterProfile?
  ownedBookings   Booking[]            @relation("OwnerBookings")
  sitterBookings  Booking[]            @relation("SitterBookings")
  questClaims     QuestClaim[]
  notifications   Notification[]
  pushDevices     PushDevice[]
  bookingOperations BookingOperation[]
  firstConversations Conversation[] @relation("FirstParticipant")
  secondConversations Conversation[] @relation("SecondParticipant")
  chatMessages ChatMessage[]
  writtenReviews SitterReview[] @relation("ReviewAuthor")
  receivedReviews SitterReview[] @relation("ReviewedSitter")
  walkSessions WalkSession[]
}

model UserProfile {
  id        String    @id @default(cuid())
  accountId String    @unique
  fullName  String
  phone     String
  birthDate DateTime?
  photoKey  String?
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model ClinicProfile {
  id         String  @id @default(cuid())
  accountId  String  @unique
  clinicName String
  nip        String  @unique
  phone      String
  address    String?
  registrationNumber String?
  verificationStatus ClinicVerificationStatus @default(UNVERIFIED)
  verificationVersion Int @default(0)
  verificationSubmittedAt DateTime?
  verificationReviewedAt DateTime?
  verificationReviewedBy String?
  verificationReason String?
  verificationEvidenceUrl String?
  account    Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([verificationStatus, verificationSubmittedAt])
}

model RefreshToken {
  id        String    @id
  accountId String
  tokenHash String
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([familyId])
}

model AccountActionToken {
  id        String           @id @default(cuid())
  accountId String
  type      AccountTokenType
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  pendingEmail String?
  account   Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, type])
  @@index([expiresAt])
}

model Pet {
  id        String    @id @default(cuid())
  accountId String
  name      String
  age       Int?
  breed     String?
  size      PetSize?
  temperament String?
  mobilityRestrictions String?
  careInstructions String?
  photoKeys String[] @default([])
  weight    Float?
  gender    PetGender
  photoUrl  String?
  photoKey  String?
  illnesses String?
  allergies String?
  vaccines  String?
  vet       String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  documents PetDocument[]
  shareLinks PetShareLink[]

  @@index([accountId])
}

enum PetSize {
  SMALL
  MEDIUM
  LARGE
}

model SitterProfile {
  id              String             @id @default(cuid())
  accountId       String             @unique
  bio             String
  city            String
  region          String?
  photoKey        String?
  latitude        Float
  longitude       Float
  serviceRadiusKm Int                @default(10)
  isActive        Boolean            @default(true)
  verificationStatus SitterVerificationStatus @default(UNVERIFIED)
  verificationVersion Int @default(0)
  verificationSubmittedAt DateTime?
  verificationReviewedAt DateTime?
  verificationReviewedBy String?
  verificationReason String?
  verificationFullName String?
  verificationFiles SitterVerificationFile[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  account         Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  services        SitterService[]
  availability    AvailabilitySlot[]

  @@index([isActive, city])
  @@index([verificationStatus, verificationSubmittedAt])
}

model SitterVerificationFile {
  id String @id @default(uuid())
  profileId String
  purpose SitterVerificationFilePurpose
  stagingKey String @unique
  objectKey String @unique
  contentType String
  sizeBytes Int
  uploadedAt DateTime?
  verificationVersion Int?
  expiresAt DateTime
  createdAt DateTime @default(now())
  profile SitterProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, verificationVersion, purpose])
  @@index([expiresAt])
}

model SitterService {
  id              String            @id @default(cuid())
  sitterProfileId String
  type            SitterServiceType
  durationMinutes Int
  priceCents      Int
  currency        String            @default("PLN")
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  sitterProfile   SitterProfile     @relation(fields: [sitterProfileId], references: [id], onDelete: Cascade)
  bookings        Booking[]

  @@unique([sitterProfileId, type, durationMinutes])
  @@index([type, isActive])
}

model AvailabilitySlot {
  id              String        @id @default(cuid())
  sitterProfileId String
  startsAt        DateTime
  endsAt          DateTime
  archivedAt      DateTime?
  createdAt       DateTime      @default(now())
  sitterProfile   SitterProfile @relation(fields: [sitterProfileId], references: [id], onDelete: Cascade)
  bookings        Booking[]

  @@index([sitterProfileId, startsAt])
}

model BookingOperation {
  accountId   String
  key         String
  requestHash String
  result      Json?
  createdAt   DateTime @default(now())
  account     Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, key])
}

model Booking {
  id                 String           @id @default(cuid())
  ownerAccountId     String
  sitterAccountId    String
  petId              String
  sitterServiceId    String
  availabilitySlotId String
  status             BookingStatus    @default(REQUESTED)
  activeSlotKey      String?
  startsAt           DateTime
  endsAt             DateTime
  expiresAt          DateTime
  priceCents         Int
  currency           String           @default("PLN")
  note               String?
  pickupAddress      String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  owner              Account          @relation("OwnerBookings", fields: [ownerAccountId], references: [id], onDelete: Cascade)
  sitter             Account          @relation("SitterBookings", fields: [sitterAccountId], references: [id], onDelete: Cascade)
  pet                Pet              @relation(fields: [petId], references: [id], onDelete: Restrict)
  sitterService      SitterService    @relation(fields: [sitterServiceId], references: [id], onDelete: Restrict)
  availabilitySlot   AvailabilitySlot @relation(fields: [availabilitySlotId], references: [id], onDelete: Restrict)
  notifications      Notification[]
  review             SitterReview?
  walkSession        WalkSession?
  paymentRequired    Boolean @default(false)
  paymentDueAt       DateTime?
  paidPaymentId      String? @unique
  cancellationFeeCents Int @default(0)
  cancelledAt        DateTime?
  paidPayment        Payment? @relation("PaidBooking", fields: [paidPaymentId], references: [id], onDelete: SetNull)
  payments           Payment[] @relation("BookingPayments")
  settlement         PaymentSettlement?
  issue              BookingIssue?

  @@index([ownerAccountId, createdAt])
  @@index([sitterAccountId, createdAt])
  @@index([availabilitySlotId])
  @@index([status, expiresAt])
}

enum BookingIssueStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum BookingIssueCategory {
  NO_SHOW
  EARLY_FINISH
  PET_SAFETY
  OTHER
}

model BookingIssue {
  id                String @id @default(cuid())
  bookingId         String @unique
  reporterAccountId String
  category          BookingIssueCategory
  description       String
  status            BookingIssueStatus @default(OPEN)
  version           Int @default(1)
  resolution        String?
  reviewedBy        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  booking           Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([reporterAccountId, createdAt])
}

enum PaymentStatus {
  CREATING
  PENDING
  AUTHORIZED
  COMPLETED
  CANCELED
  FAILED
}

model Payment {
  id String @id @default(cuid())
  bookingId String
  environment String
  status PaymentStatus @default(CREATING)
  activeKey String? @unique
  amountCents Int
  currency String @default("PLN")
  payuOrderId String? @unique
  checkoutUrl String?
  customerIp String
  buyerEmail String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  nextSyncAt DateTime @default(now())
  leaseUntil DateTime?
  leaseToken String?
  attempts Int @default(0)
  lastErrorCode String?
  booking Booking @relation("BookingPayments", fields: [bookingId], references: [id], onDelete: Cascade)
  paidBooking Booking? @relation("PaidBooking")
  refund PaymentRefund?

  @@index([nextSyncAt])
  @@index([bookingId, createdAt])
}

model PaymentRefund {
  id String @id @default(cuid())
  paymentId String @unique
  amountCents Int
  status String @default("REQUESTED")
  payuRefundId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastErrorCode String?
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model PaymentSettlement {
  bookingId String @id
  amountCents Int
  kind String
  createdAt DateTime @default(now())
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model WalkSession {
  id String @id @default(cuid())
  bookingId String @unique
  sitterAccountId String
  startedAt DateTime @default(now())
  endedAt DateTime?
  endReason String?
  distanceMeters Float @default(0)
  lastSequence Int @default(0)
  distanceAnchorSequence Int @default(0)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sitter Account @relation(fields: [sitterAccountId], references: [id], onDelete: Cascade)
  points WalkPoint[]
}

model WalkPoint {
  sessionId String
  sequence Int
  clientPointId String
  latitude Float
  longitude Float
  accuracy Float
  capturedAt DateTime
  segmentStart Boolean @default(false)
  session WalkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, sequence])
  @@unique([sessionId, clientPointId])
}

model SitterReview {
  id String @id @default(cuid())
  bookingId String @unique
  authorAccountId String
  sitterAccountId String
  punctuality Int
  communication Int
  quality Int
  comment String?
  createdAt DateTime @default(now())
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author Account @relation("ReviewAuthor", fields: [authorAccountId], references: [id], onDelete: Cascade)
  sitter Account @relation("ReviewedSitter", fields: [sitterAccountId], references: [id], onDelete: Cascade)

  @@index([sitterAccountId, createdAt, id])
  @@index([authorAccountId])
}

model PetDocument {
  id                 String   @id @default(cuid())
  petId              String
  objectKey          String   @unique
  stagingKey         String? @unique
  contentType        String @default("application/pdf")
  purpose            PetDocumentPurpose @default(GENERAL)
  name               String
  sizeBytes          Int
  expiresAt          DateTime?
  reminderDaysBefore Int      @default(7)
  reminderSentAt     DateTime?
  uploadedAt         DateTime?
  createdAt          DateTime @default(now())
  pet                Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([expiresAt, reminderSentAt])
}

enum PetDocumentPurpose {
  GENERAL
  VACCINATION
}

model PetShareLink {
  id               String   @id @default(cuid())
  petId            String
  tokenHash        String   @unique
  label            String?
  includeDocuments Boolean  @default(false)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  pet              Pet      @relation(fields: [petId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([petId, createdAt])
  @@index([expiresAt])
}

model Notification {
  id        String           @id @default(cuid())
  accountId String
  bookingId String?
  conversationId String?
  chatMessageId String? @unique
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  deliveryEnqueuedAt DateTime?
  deliveries NotificationDelivery[]
  account   Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  booking   Booking?         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  chatMessage ChatMessage? @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([accountId, readAt])
  @@index([conversationId, accountId])
}

model Conversation {
  id String @id @default(cuid())
  firstAccountId String
  secondAccountId String
  firstReadSequence Int @default(0)
  secondReadSequence Int @default(0)
  lastSequence Int @default(0)
  createdAt DateTime @default(now())
  lastActivityAt DateTime @default(now())
  first Account @relation("FirstParticipant", fields: [firstAccountId], references: [id], onDelete: Cascade)
  second Account @relation("SecondParticipant", fields: [secondAccountId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  notifications Notification[]

  @@unique([firstAccountId, secondAccountId])
  @@index([firstAccountId, lastActivityAt, id])
  @@index([secondAccountId, lastActivityAt, id])
}

model ChatMessage {
  id String @id @default(cuid())
  conversationId String
  senderAccountId String
  clientMessageId String
  sequence Int
  text String
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender Account @relation(fields: [senderAccountId], references: [id], onDelete: Cascade)
  notification Notification?

  @@unique([conversationId, sequence])
  @@unique([conversationId, senderAccountId, clientMessageId])
}

model PushDevice {
  id        String @id @default(cuid())
  accountId String
  token     String @unique
  sessionId String
  createdAt DateTime @default(now())
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@index([accountId])
}

model NotificationDelivery {
  id             String @id @default(cuid())
  notificationId String
  channel        String
  destination    String
  attempts       Int @default(0)
  nextAttemptAt  DateTime @default(now())
  lockedUntil    DateTime?
  sentAt         DateTime?
  failedAt       DateTime?
  ticketId       String?
  receiptCheckedAt DateTime?
  createdAt      DateTime @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  @@unique([notificationId, channel, destination])
  @@index([sentAt, failedAt, nextAttemptAt])
}

model AuditLog {
  id              String @id @default(cuid())
  actorAccountId  String
  targetAccountId String
  action          String
  reason          String?
  createdAt       DateTime @default(now())
  @@index([targetAccountId, createdAt])
}

model QuestClaim {
  id        String   @id @default(cuid())
  accountId String
  questId   String
  points    Int
  claimedAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, questId])
}
