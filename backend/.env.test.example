# Copy to backend/.env.test. Never point tests at a development database.
NODE_ENV=test
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/pupply_test
JWT_ACCESS_SECRET=test_access_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=test_refresh_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_TTL_DAYS=7
CORS_ORIGIN=*
AUTH_RATE_LIMIT_MAX=1000

# Optional MinIO integration tests (create a private bucket separately)
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_BUCKET=pupply-test
# S3_DOCUMENT_BUCKET=pupply-test-documents
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
